JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Existing MySQL on the VDS host. URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://training:replace-password@host.docker.internal:3306/training?charset=utf8mb4
ENVIRONMENT=production
DOMAIN=api.example.com
CORS_ORIGINS=[]
NOTIFICATION_THRESHOLD=2
