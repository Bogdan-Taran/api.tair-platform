# Copy to .env; use independent random secrets. URL-encode special password characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-alphanumeric-password
DATABASE_URL=postgresql+psycopg://training:replace-with-a-random-alphanumeric-password@db:5432/training
ENVIRONMENT=production
DOMAIN=api.example.com
CORS_ORIGINS=[]
NOTIFICATION_THRESHOLD=2
